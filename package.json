{
  "name": "wildblocks",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "server": "node server/entry.cjs",
    "build:mac": "electron-packager . Wildblocks --platform=darwin --arch=arm64 --out=../wildblocks-desktop --overwrite --ignore='^/(server-data|tests|.*\\.png|SPEC.md|README.md|ORIGINAL-GAMES.md|CHANGELOG.md|.*\\.command|.git)' && codesign --force --deep --sign - ../wildblocks-desktop/Wildblocks-darwin-arm64/Wildblocks.app",
    "build:server": "node scripts/build-portable-server.mjs",
    "check": "node scripts/check.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0"
  },
  "version": "0.11.0",
  "main": "desktop/main.cjs",
  "description": "An original multiplayer voxel sandbox with crafting, survival, creative building, and self-hosted servers.",
  "author": "Wildblocks",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/drakeg/wildblocks.git"
  },
  "homepage": "https://github.com/drakeg/wildblocks"
}
