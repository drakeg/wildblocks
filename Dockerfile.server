# Wildblocks dedicated server: no npm dependencies or desktop runtime.
FROM node:26-alpine
WORKDIR /opt/wildblocks
COPY --chown=node:node server/ ./server/
COPY --chown=node:node dist/ ./dist/
RUN mkdir -p /var/lib/wildblocks && chown node:node /var/lib/wildblocks
USER node
EXPOSE 4182
VOLUME ["/var/lib/wildblocks"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4182/api/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/entry.cjs"]
