<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.wildblocks.server</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/node</string>
    <string>/usr/local/lib/wildblocks/server/entry.cjs</string>
    <string>--config</string><string>/usr/local/lib/wildblocks/server.config.json</string>
  </array>
  <key>UserName</key><string>_wildblocks</string>
  <key>GroupName</key><string>_wildblocks</string>
  <key>WorkingDirectory</key><string>/usr/local/lib/wildblocks</string>
  <key>EnvironmentVariables</key><dict><key>WILDBLOCKS_DATA</key><string>/usr/local/var/wildblocks</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/usr/local/var/wildblocks/server.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/wildblocks/error.log</string>
</dict></plist>
